# TEMPLATE ONLY: enter real values in Render's secret environment settings.
# URL-encode the database role/password. Do not paste psql command wrappers.
DATABASE_URL=postgresql://APP_ROLE:URL_ENCODED_PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&sslrootcert=system&connect_timeout=10&pool_max_conns=4&pool_min_conns=0&pool_max_conn_idle_time=60s
JWT_SECRET=GENERATE_A_NEW_RANDOM_SECRET_WITH_AT_LEAST_32_BYTES
FRONTEND_URL=https://YOUR-FRONTEND.example
# Render supplies PORT automatically. The Docker image defaults to 10000.
PORT=10000
UPLOAD_DIR=/var/lib/signora/uploads
SIGNED_DIR=/var/lib/signora/signed
# Preview acknowledgement, not a persistence mechanism.
ALLOW_EPHEMERAL_PDF_STORAGE=true
# Leave credentials unset on Free. Gmail 465/587 will not work.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
