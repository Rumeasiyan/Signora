# Template only. Configure a NEW backend project; do not alter existing frontend.
PORT=8080
DATABASE_URL=postgresql://APP_ROLE:URL_ENCODED_PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&sslrootcert=system&connect_timeout=10&pool_max_conns=4&pool_min_conns=0&pool_max_conn_idle_time=60s
JWT_SECRET=GENERATE_A_NEW_RANDOM_SECRET_WITH_AT_LEAST_32_BYTES
FRONTEND_URL=https://YOUR-EXISTING-FRONTEND.example
UPLOAD_DIR=/tmp/signora/uploads
SIGNED_DIR=/tmp/signora/signed
# These acknowledge a limited preview, not durable storage or 20 MB support.
ALLOW_EPHEMERAL_PDF_STORAGE=true
ACKNOWLEDGE_VERCEL_UPLOAD_LIMIT=true
# Optional existing SMTP transport; provider delivery remains untested.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
