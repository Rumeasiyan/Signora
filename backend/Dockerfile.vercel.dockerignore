# Dockerfile-specific ignore file; the Render .dockerignore stays unchanged.
**
!Dockerfile.vercel
!Dockerfile.vercel.dockerignore
!go.mod
!go.sum
!package.json
!package-lock.json
!cmd/
!cmd/**
!internal/
!internal/**
!scripts/
scripts/**
!scripts/stamp_pdf.js
!deploy/
deploy/**
!deploy/vercel-validate-env.mjs
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pdf
**/uploads/**
**/signed/**
**/node_modules/**
**/.git/**
